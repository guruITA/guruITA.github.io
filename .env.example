# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored. Both values below are public (they end up in the built site);
# the secrets live only in the contact Worker (workers/contact-form).

# URL of the deployed contact Worker, e.g. https://guruita-contact-form.<account>.workers.dev
# Locally: http://localhost:8787 (run `npm run dev` in workers/contact-form).
VITE_CONTACT_FORM_ENDPOINT=

# Site key of the Cloudflare Turnstile widget. For local testing use Cloudflare's test key that always passes:
# 1x00000000000000000000AA (https://developers.cloudflare.com/turnstile/troubleshooting/testing/)
VITE_TURNSTILE_SITE_KEY=
